# .NET
bin/
obj/
dist/
*.user
*.suo
.vs/

# tools dropped next to the exe (ffmpeg.exe / mpv.exe are downloaded separately)
tools/
*.exe
!scripts/*.exe

# logs / local config
logs/
*.log

# OS
Thumbs.db
.DS_Store

# Rust
target/
.cargo/config.toml

# ui tooling
node_modules/

# Tauri generated schemas
app/gen/

