<Project Sdk="Microsoft.NET.Sdk">
  <!-- net48: runs on the .NET Framework 4.8 that ships inside Windows 10 (1903+) / 11. Single EXE, zero install.
       Built on Linux with `dotnet build -c Release` (reference assemblies come from NuGet). -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>HdrCastSender</AssemblyName>
    <RootNamespace>HdrCast.Sender</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <Prefer32Bit>false</Prefer32Bit>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.IO.Pipes" />
    <!-- capture engine: DXGI Desktop Duplication + D3D11 compute shader + WASAPI loopback -->
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
    <PackageReference Include="SharpDX.D3DCompiler" Version="4.2.0" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- Release: merge the dependency DLLs into the single exe (see ILRepack.targets) -->
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.43" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- shared, platform-neutral logic (also compiled into the receiver and the Linux test project) -->
    <Compile Include="../shared/**/*.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
